# Скопируй этот файл в .env и впиши свой ключ.
# Ключ берётся здесь: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Порт, на котором поднимется сервер.
PORT=3000

# Модель мастера. По умолчанию — самая способная из линейки Opus.
# Дешевле и быстрее: claude-sonnet-5
DM_MODEL=claude-opus-5

# Сколько модель думает над ходом: low | medium | high | xhigh | max
# medium — разумный компромисс: мастер отвечает за несколько секунд.
# high и выше заметно умнее в бою и интригах, но ждать дольше и дороже.
DM_EFFORT=medium

# Пауза после реплики игрока, прежде чем мастер начнёт отвечать (мс).
# Нужна, чтобы несколько игроков успели высказаться до его хода.
DM_DEBOUNCE_MS=1400

# Потолок ответа мастера в токенах (сюда же входят его размышления).
DM_MAX_TOKENS=16000

# Размер истории в символах, после которого она сворачивается в хронику.
DM_HISTORY_BUDGET=90000
