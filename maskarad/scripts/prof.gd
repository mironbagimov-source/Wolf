extends Node
## Секундомер по системам. Автозагрузка `Prof`.
##
## Средний кадр в пять миллисекунд ничего не говорит о том, ЧТО эти пять
## миллисекунд заняло. Пока не известно, чей это кусок — ботов, актёров или
## анимации, — любая оптимизация делается наугад.
##
## Включается ключом `--perf`, в обычной игре не стоит ни одного вызова:
## поля читаются через `if Prof.on`, и при выключенном профиле это одна
## проверка булева на кадр.
var on: bool = false
var brains: int = 0
var actors: int = 0
var rig: int = 0

func take() -> Dictionary:
	var out := {"brains": brains / 1000.0, "actors": actors / 1000.0, "rig": rig / 1000.0}
	brains = 0
	actors = 0
	rig = 0
	return out
