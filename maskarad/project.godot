; Маскарад — асимметричный социальный хоррор
; Люди против нечисти. Godot 4.3+.
;
; Ввод объявляется в коде (Data._ready), а не здесь: так его видно рядом с
; остальными правилами и не приходится править бинароподобные блоки руками.

config_version=5

[application]

config/name="Маскарад"
config/description="Асимметричный социальный хоррор: трое людей, нечисть среди гостей бала и одна ночь до рассвета."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Data="*res://scripts/data.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[physics]

3d/default_gravity=18.0

[rendering]

anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.05, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
