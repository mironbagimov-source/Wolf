# Копия: cp config.env.example config.env  — и заполнить DEEPSEEK_API_KEY.
# config.env в .gitignore: ключ в репозиторий не попадёт.

# --- сервер и контейнер (значения из памятки к node18) ---
SERVER_IP=158.160.240.14
NODE_NUM=18
CONTAINER_NAME=node18

# Приватный ключ от контейнера. Положи файл yc_node18 сюда и закрой права:
#   chmod 600 ~/.ssh/yc-nodes/yc_node18
SSH_KEY=~/.ssh/yc-nodes/yc_node18

# --- есть ли у тебя root на ХОСТЕ (не в контейнере)? ---
# no  — обычный случай: контейнер выдали готовым, ты входишь только внутрь.
#       Шаги 01 и 02 не нужны, gateway поднимается изнутри контейнера.
# yes — ты сам администрируешь сервер: доступны создание контейнера
#       и автозапуск gateway через entrypoint на хосте.
HOST_ACCESS=no

# Логин на хосте — нужен только при HOST_ACCESS=yes.
SERVER_SSH_USER=root

# Образ — нужен только при HOST_ACCESS=yes.
IMAGE=vps-node:latest

# --- DeepSeek ---
# ВНИМАНИЕ: ключ из постановки задачи был передан открытым текстом в переписке —
# считай его скомпрометированным и выпусти новый:
#   https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Промпт требует deepseek-v4-flash. Такой модели может не существовать:
# публичный API DeepSeek отдаёт deepseek-chat и deepseek-reasoner.
# 00-preflight.sh сверит это с живым GET /models и покажет реальный список.
DEEPSEEK_MODEL=deepseek-v4-flash

# Критично: без base_url hermes уходит в OpenRouter и ловит
# 403 "Access denied by security policy." на серверных IP.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- веб-интерфейс (шаг 08) ---
# Порт слушается на 127.0.0.1 внутри контейнера и пробрасывается
# ssh-туннелем. Меняй, если 8080 уже занят на твоей машине.
WEB_PORT=8080
