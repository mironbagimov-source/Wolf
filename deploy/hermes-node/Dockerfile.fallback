# Запасной образ, если vps-node:latest на сервере нет.
#
# Почему не как в исходной инструкции: там предлагалось запустить голый
# ubuntu:24.04 с --entrypoint node-entry.sh, а *потом* доустановить внутрь
# sshd и пользователя admin. Так не выйдет — entrypoint первой же строкой
# зовёт /usr/sbin/sshd, которого в чистом ubuntu нет, контейнер падает
# сразу, и `docker exec` выполнять уже негде. Поэтому образ собирается
# заранее, а entrypoint получает готовую систему.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# xz-utils и unzip — обязательны: без них установщик hermes падает
# на распаковке tar.xz и zip соответственно.
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server sudo ca-certificates curl git \
        xz-utils unzip procps \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash admin \
    && usermod -aG sudo admin \
    && echo 'admin ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/admin \
    && chmod 440 /etc/sudoers.d/admin

# Вход только по ключу; root по SSH запрещён.
RUN mkdir -p /home/admin/.ssh /run/sshd \
    && touch /home/admin/.ssh/authorized_keys \
    && chown -R admin:admin /home/admin/.ssh \
    && chmod 700 /home/admin/.ssh \
    && chmod 600 /home/admin/.ssh/authorized_keys \
    && printf '\nPermitRootLogin no\nPasswordAuthentication no\nPubkeyAuthentication yes\n' \
       >> /etc/ssh/sshd_config

EXPOSE 22
