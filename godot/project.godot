; Godot 4 project configuration for "Рейвенсторп — Паразит".
; Almost everything is built in code (see scripts/Main.gd), so the scene tree
; and the .import pipeline stay tiny — this project has no binary assets and can
; be authored/edited entirely as text. Open the folder in Godot 4.2+ and run.

config_version=5

[application]

config/name="Рейвенсторп — Паразит"
config/description="Хоррор-шутер в духе F.E.A.R.: отряд наёмников против паразита, превращающего людей в пауков."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.06, 1)
anti_aliasing/quality/msaa_3d=1

[physics]

common/enable_pause_aware_picking=true
