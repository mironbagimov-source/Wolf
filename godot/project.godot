[rendering]

# Совместимый рендер (OpenGL3) по умолчанию: Forward+/Vulkan есть не на всякой
# видеокарте, и на старой карте игра просто открывалась чёрным экраном. OpenGL3
# тянут все. Плата — нет SSAO/SSIL (они только в Forward+); свет, туман,
# свечение, карты нормалей и материалы работают и здесь.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

environment/defaults/default_clear_color=Color(0.02, 0.024, 0.04, 1)
